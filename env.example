# ghost-publisher — environment template
#
# This file is the TEMPLATE. It contains no real secret and is committed.
# (It is named `env.example` rather than `.env.example` because this machine
# has a safety hook that blocks agents from writing any `.env*` path.)
#
# HOW TO USE:
#   1. Copy it:   cp env.example .env
#   2. Paste your real key into `.env` — NOT into this file.
#   3. `.env` is git-ignored. Never commit it, never paste the key into a chat.
#
# ---------------------------------------------------------------------------
# GHOST_ADMIN_API_KEY  (required for live runs; NOT needed for --dry-run)
# ---------------------------------------------------------------------------
# Where to get it:
#   Ghost admin -> Settings -> Advanced -> Integrations
#   -> Add custom integration (name it e.g. "ghost-publisher")
#   -> copy the **Admin API key**.
#
# It is NOT the Content API key. The Admin API key is one string with a colon
# in the middle, in the form  <id>:<secret>
#     <id>     = 24 hex characters
#     <secret> = 64 hex characters
# Paste it verbatim, including the colon. No quotes, no spaces.
#
GHOST_ADMIN_API_KEY=REPLACE_WITH_ID:REPLACE_WITH_SECRET

# ---------------------------------------------------------------------------
# GHOST_API_URL  (required)
# ---------------------------------------------------------------------------
# Base URL of the Ghost site — scheme + host only.
# No trailing slash, and do NOT append /ghost/api/admin — the script does that.
#
GHOST_API_URL=https://thomasadair.ghost.io

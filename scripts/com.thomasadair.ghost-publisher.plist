<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ghost-publisher weekly trigger.

  Runs every Monday at 08:00 local time. That run schedules the top queued
  piece for the next cadence slot (default Tuesday 09:00) — roughly 25 hours
  of lead time, comfortably above config.yaml's min_lead_minutes.

  __PROJECT_DIR__ is substituted by scripts/install-launchd.sh. Do not load
  this file directly from the repo.

  Weekday values: 0/7 = Sunday, 1 = Monday, 2 = Tuesday, ... 6 = Saturday.

  If the Mac is asleep at 08:00, launchd runs the job once on the next wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thomasadair.ghost-publisher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/run.sh</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
